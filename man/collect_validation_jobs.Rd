\name{collect_validation_jobs}
\alias{collect_validation_jobs}
\title{Collect validation checkpoints from one or more directories}
\usage{
collect_validation_jobs(path, plan = NULL, strict = TRUE)
}
\arguments{
  \item{path}{Manifest/output directory or character vector of directories.}
  \item{plan}{Optional validation plan.}
  \item{strict}{Fail when duplicate job identifiers disagree.}
}
\value{The documented eyeprocess object, data frame, plot, report path, or adapter result.}
\description{Part of the research-scale validation, advanced-model, interoperability, storage, adapter, or reproducibility programme. Experimental model functions remain subject to declared evidence gates.}
