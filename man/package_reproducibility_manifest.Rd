\name{package_reproducibility_manifest}
\alias{package_reproducibility_manifest}
\title{Create a reproducibility manifest for files and software}
\usage{
package_reproducibility_manifest(paths, include_session = TRUE)
}
\arguments{
  \item{paths}{Files/directories.}
  \item{include_session}{Whether to capture session information.}
}
\value{The documented eyeprocess object, data frame, plot, report path, or adapter result.}
\description{Part of the research-scale validation, advanced-model, interoperability, storage, adapter, or reproducibility programme. Experimental model functions remain subject to declared evidence gates.}
