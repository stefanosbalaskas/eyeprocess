\name{fit_external_engine}
\alias{fit_external_engine}
\title{Fit an external model engine through a stable adapter}
\usage{
fit_external_engine(engine, data, specification = NULL, purpose, ...)
}
\arguments{
  \item{engine}{Engine name.}
  \item{data}{Engine-ready data.}
  \item{specification}{Engine-specific specification.}
  \item{purpose}{Declared scientific purpose.}
  \item{...}{Engine arguments.}
}
\value{The documented eyeprocess object, data frame, plot, report path, or adapter result.}
\description{Part of the research-scale validation, advanced-model, interoperability, storage, adapter, or reproducibility programme. Experimental model functions remain subject to declared evidence gates.}
