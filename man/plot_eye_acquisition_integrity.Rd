\name{plot_eye_acquisition_integrity}
\alias{plot_eye_acquisition_integrity}
\title{Visualise observed acquisition intervals}
\usage{plot_eye_acquisition_integrity(x)}
\arguments{\item{x}{An acquisition-integrity audit object.}}
