\name{write_validation_release_report}
\alias{write_validation_release_report}
\title{Write a validation release report}
\usage{
write_validation_release_report(x, path, completion = NULL, promotion = NULL,
  title = "eyeprocess validation release report", include_session = TRUE)
}
\arguments{
  \item{x}{Validation collection.}
  \item{path}{Markdown output file.}
  \item{completion}{Optional completion audit.}
  \item{promotion}{Optional model-promotion audit.}
  \item{title}{Report title.}
  \item{include_session}{Include session information.}
}
\value{The documented eyeprocess object, data frame, plot, report path, or adapter result.}
\description{Part of the research-scale validation, advanced-model, interoperability, storage, adapter, or reproducibility programme. Experimental model functions remain subject to declared evidence gates.}
